# .env.example
# Copy this file to .env and fill in values for local development.
# Do NOT commit the .env file to version control.

# -------------------------
# --- API Keys (Secrets)
# -------------------------

TAVILY_API_KEY="your_key_here"
# LLM_API_KEY="your-openshift-ai-token-if-required"

# -------------------------
# --- MCP Server URLs
# -------------------------
# Full HTTP URLs to each MCP service. For local dev, run servers on these ports.
# For OpenShift, use in-cluster service DNS names (patched by Kustomize).

LLM_MCP_URL="http://127.0.0.1:8001"
RAG_MCP_URL="http://127.0.0.1:8002"
SEARCH_MCP_URL="http://127.0.0.1:8003"
ANALYTICS_MCP_URL="http://127.0.0.1:8004"

# Legacy port-only settings (used to build URLs when MCP_*_URL is not set)
LLM_MCP_PORT="8001"
RAG_MCP_PORT="8002"
SEARCH_MCP_PORT="8003"
ANALYTICS_MCP_PORT="8004"

# -------------------------
# --- LLM Backend (kServe / vLLM)
# -------------------------

# OpenAI-compatible endpoint for the model served by OpenShift AI / kServe.
LLM_API_BASE="http://127.0.0.1:8080/v1"
LLM_MODEL_NAME="gpt-4o-mini"

# Hugging Face model used for Granite on kServe
MODEL_HF_REPO="ibm-granite/granite-3.0-2b-instruct"
MODEL_LOCAL_DIR="./models/granite-3b"
# HF_TOKEN="your_hf_token_if_required"

# Deprecated alias kept for backward compatibility:
# GRANITE_ENDPOINT="http://127.0.0.1:8080"

# -------------------------
# --- RAG / Milvus
# -------------------------

MILVUS_HOST="127.0.0.1"
MILVUS_PORT="19530"
MILVUS_URI="http://127.0.0.1:19530"
MILVUS_COLLECTION_NAME="meridian_knowledge"
EMBEDDING_MODEL="all-MiniLM-L6-v2"
# Set to true to skip Milvus and use static fallback documents locally.
RAG_USE_FALLBACK="false"
TAVILY_MAX_RESULTS="5"

# -------------------------
# --- PostgreSQL
# -------------------------

# Async SQLAlchemy URL used by analytics MCP, seed scripts, and Alembic.
# Example local: postgresql+asyncpg://meridian:secret@127.0.0.1:5432/meridian
DATABASE_URL=""

# When true (or when DATABASE_URL is empty), services read data/*.json directly.
USE_JSON_FALLBACK="true"

# Optional override for seed JSON directory (defaults to ./data)
# DATA_PATH="./data"

# -------------------------
# --- OpenShift
# -------------------------

OPENSHIFT_NAMESPACE="retail-ai-demo"

# -------------------------
# --- Debugging
# -------------------------

LOG_LEVEL="INFO"
MERIDIAN_DEBUG="false"
